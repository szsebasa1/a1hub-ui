# .brainignore — paths brain will NOT ingest (gitignore-style globs).
# Generated by `brain setup` / `brain brainignore`. Edit freely.

# Cross-ecosystem noise
.git/
.hg/
.svn/
.DS_Store
.idea/
.vscode/
*.log
*.map
coverage/
.cache/

# Node / JS / TS (npm, pnpm, yarn)
node_modules/
dist/
build/
out/
.next/
.nuxt/
.svelte-kit/
.turbo/
.parcel-cache/
*.tsbuildinfo
*.min.js
*.min.css
